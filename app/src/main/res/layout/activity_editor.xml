<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editor_bg"
    android:orientation="vertical">

    <!-- 顶部工具栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_edit"
        app:title="@string/editor"
        app:titleTextColor="@color/white">

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingEnd="16dp"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 章节标题输入 -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etChapterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/editor_bg"
        android:hint="@string/chapter_title"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="@color/editor_text"
        android:textColorHint="@color/text_hint"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/divider" />

    <!-- 正文内容容器（编辑模式 + 阅读模式共享区域） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 编辑模式 -->
        <ScrollView
            android:id="@+id/svEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:hint="开始创作..."
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.6"
                android:padding="16dp"
                android:textColor="@color/editor_text"
                android:textColorHint="@color/text_hint"
                android:textSize="18sp" />

        </ScrollView>

        <!-- 阅读模式 -->
        <ScrollView
            android:id="@+id/svReader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/reader_bg_parchment"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="32dp">

                <TextView
                    android:id="@+id/tvReaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/reader_title"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReaderContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:lineSpacingMultiplier="1.8"
                    android:textColor="@color/reader_text_light"
                    android:textSize="18sp" />

                <!-- 章节导航 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevChapter"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/prev_chapter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextChapter"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/next_chapter" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- 底部写作助手工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/redo"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voice_input"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnPreview"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/preview"
            android:src="@drawable/ic_preview"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnConvert"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/punctuation_convert"
            android:src="@drawable/ic_comment"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnStats"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stats"
            android:src="@drawable/ic_comment"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/save"
            android:src="@drawable/ic_edit"
            app:tint="@color/primary" />

    </LinearLayout>

</LinearLayout>
